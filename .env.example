# Copy to .env.local for local development. On Vercel these come from the project's
# Environment Variables — the Supabase integration (Vercel → Storage → Supabase) creates the
# NEXT_PUBLIC_* and POSTGRES_* ones for you; you only add ADMIN_EMAILS.
#
# Leave everything empty and the site runs exactly as before, keeping dashboard data in the browser.

# --- Supabase, public (safe in the browser; row-level security protects the data) ---------------
# Either the VITE_ names or the NEXT_PUBLIC_ names the Vercel integration creates.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=        (or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)

# --- Build time only: creates/updates the tables before each deploy ------------------------------
# Supabase → Project Settings → Database → Connection string (URI). The Vercel integration sets
# POSTGRES_URL_NON_POOLING, which works too. Never prefix this with VITE_ or NEXT_PUBLIC_.
SUPABASE_DB_URL=

# Who may open /admin (comma-separated). Each address signs in with a password or an emailed link.
ADMIN_EMAILS=

# Set to "skip" to build without touching the database.
# DB_MIGRATE=skip

# --- Optional -----------------------------------------------------------------------------------
# Where "media:" image references load from. Leave unset to keep using the WordPress uploads folder.
# After `npm run fetch-media`, point it at the copies bundled with the site:
# VITE_MEDIA_BASE=/media
